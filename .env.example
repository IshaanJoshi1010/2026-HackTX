# Public site URL (canonical / Open Graph). Matches Vercel Production (www).
NEXT_PUBLIC_SITE_URL=https://www.fork-toyota.tech
# Server-side only. Put real credentials in ignored .env.local; never commit them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# SerpApi (dealer lookup, server-side only). Empty here; the route falls back to saved snapshots without it.
SERPAPI_API_KEY=
